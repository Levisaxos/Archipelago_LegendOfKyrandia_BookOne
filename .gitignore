# ─────────────────────────────────────────────────────────────────────────
#  Archipelago – Legend of Kyrandia (Book 1)  ·  .gitignore
#  Goal: commit our work + the build recipe; exclude anything large that is
#  re-fetched, re-extracted, or regenerated. See SETUP.md to reconstitute.
# ─────────────────────────────────────────────────────────────────────────

# ── MSVC / build output (generated by create_project + MSBuild) ──────────
/build/msvc/
*.obj
*.lib
*.exe
*.pdb
*.ilk
*.idb
*.exp

# ── Third-party dependencies (re-cloned/-downloaded at build time) ───────
#    NB: build/deps/ap/bridge/ (our AP bridge source) is intentionally kept.
/build/deps/SDL2-2.32.2/
/build/deps/*.zip
/build/deps/ap/apclientpp/
/build/deps/ap/wswrap/
/build/deps/ap/websocketpp/
/build/deps/ap/asio/
/build/deps/ap/json/
/build/deps/ap/test_connect.*

# ── Test / runtime artifacts (generated seeds, server + scrape logs) ─────
/build/ap_test/
/build/gen_test/
/build/run.*
/build/scrape_*.log
*.log

# ── Build artifacts that regenerate from source ──────────────────────────
# kyrandia.apworld is built by pyscripts/build_apworld.py from apworld/kyrandia/
/apworld/kyrandia.apworld
**/__pycache__/
*.pyc

# ── Vanilla ScummVM 2.0.0 tree — re-extract from the GOG scummvm-2.0.0.zip.
#    Track ONLY the engine files we modified (the fork). ───────────────────
/scummvm-2.0.0/*
!/scummvm-2.0.0/engines/
/scummvm-2.0.0/engines/*
!/scummvm-2.0.0/engines/kyra/
/scummvm-2.0.0/engines/kyra/*
!/scummvm-2.0.0/engines/kyra/kyra_lok.cpp
!/scummvm-2.0.0/engines/kyra/kyra_lok.h
!/scummvm-2.0.0/engines/kyra/scene_lok.cpp
!/scummvm-2.0.0/engines/kyra/saveload_lok.cpp
# instrumentation + flag/NPC hooks + gate work + dev tooling:
!/scummvm-2.0.0/engines/kyra/items_lok.cpp
!/scummvm-2.0.0/engines/kyra/text_lok.cpp
!/scummvm-2.0.0/engines/kyra/script_lok.cpp
!/scummvm-2.0.0/engines/kyra/kyra_v1.cpp
!/scummvm-2.0.0/engines/kyra/debugger.cpp
!/scummvm-2.0.0/engines/kyra/debugger.h
!/scummvm-2.0.0/engines/kyra/sequences_lok.cpp
!/scummvm-2.0.0/engines/kyra/animator_lok.cpp
!/scummvm-2.0.0/engines/kyra/animator_lok.h

# ── OS / editor cruft ────────────────────────────────────────────────────
.vs/
*.user
Thumbs.db
.DS_Store
/dumps
*.bak
*.lnk
